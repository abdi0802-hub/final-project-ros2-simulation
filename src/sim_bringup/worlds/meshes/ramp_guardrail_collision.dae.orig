<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <created>2026-11-05T00:00:00Z</created>
    <modified>2026-11-05T00:00:00Z</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <!-- Closed unit side barrier. Bottom z=x, top z=x+1.
       Scale 6 0.2 1.2 follows the ramp with a 1.2 m vertical barrier. -->
  <library_geometries>
    <geometry id="guardrail" name="guardrail">
      <mesh>
        <source id="positions">
          <float_array id="positions-array" count="24">0 -0.5 0  0 0.5 0  1 -0.5 1  1 0.5 1  0 -0.5 1  0 0.5 1  1 -0.5 2  1 0.5 2</float_array>
          <technique_common>
            <accessor source="#positions-array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="vertices"><input semantic="POSITION" source="#positions"/></vertices>
        <triangles count="12">
          <input semantic="VERTEX" source="#vertices" offset="0"/>
          <p>0 1 3  0 3 2  4 6 7  4 7 5  0 2 6  0 6 4  1 5 7  1 7 3  0 4 5  0 5 1  2 3 7  2 7 6</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene"><node id="guardrail-node"><instance_geometry url="#guardrail"/></node></visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#scene"/></scene>
</COLLADA>
