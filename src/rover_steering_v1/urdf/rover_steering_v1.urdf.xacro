<?xml version="1.0"?>
<robot name="rover_steering_v1">
  <link name="base_footprint">
    </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.5235" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.038189 1.4028E-08 -0.4" rpy="0 0 0" />
      <mass value="5.3544" />
      <inertia ixx="0.08924" ixy="0.0" ixz="0.0" iyy="0.17848" iyz="0.0" izz="0.232024" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/base_link.STL" />
      </geometry>
      <material name="base_link_material">
        <color rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.6 0.4 0.2" />
      </geometry>
    </collision>
  </link>
  <link name="steer1_link">
    <inertial>
      <origin xyz="-0.00087464 -1.9867E-08 -0.185" rpy="0 0 0" />
      <mass value="4.662" />
      <inertia ixx="0.039839" ixy="5.1891E-09" ixz="-5.3223E-09" iyy="0.02869" iyz="1.7198E-10" izz="0.02869" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/steer1_link.STL" />
      </geometry>
      <material name="steer1_link_material">
        <color rgba="0.96078 0.96078 0.96471 1" />
      </material>
    </visual>
  </link>
  <joint name="steer1_joint" type="fixed">
    <origin xyz="0.425 0.425 -0.1885" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="steer1_link" />
  </joint>
  <link name="wheel1_link">
    <inertial>
      <origin xyz="1.9869E-08 1.9968E-08 -0.079149" rpy="0 0 0" />
      <mass value="4.6609" />
      <inertia ixx="0.02869" ixy="-1.7072E-10" ixz="5.1892E-09" iyy="0.02869" iyz="5.3209E-09" izz="0.039839" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/wheel1_link.STL" />
      </geometry>
      <material name="wheel1_link_material">
        <color rgba="0.098039 0.098039 0.098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel1_joint" type="continuous">
    <origin xyz="-0.08 0 -0.185" rpy="1.5708 0 -1.5708" />
    <parent link="steer1_link" />
    <child link="wheel1_link" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="50" />
    <dynamics friction="0.2" />
  </joint>
  <link name="steer2_link">
    <inertial>
      <origin xyz="-0.00087463 1.9098E-08 -0.185" rpy="0 0 0" />
      <mass value="4.662" />
      <inertia ixx="0.039839" ixy="-5.0174E-09" ixz="-5.2922E-09" iyy="0.02869" iyz="-1.4328E-10" izz="0.02869" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/steer2_link.STL" />
      </geometry>
      <material name="steer2_link_material">
        <color rgba="0.96078 0.96078 0.96471 1" />
      </material>
    </visual>
  </link>
  <joint name="steer2_joint" type="fixed">
    <origin xyz="-0.42458 0.425 -0.1885" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="steer2_link" />
  </joint>
  <link name="wheel2_link">
    <inertial>
      <origin xyz="-1.8996E-08 1.9916E-08 -0.079149" rpy="0 0 0" />
      <mass value="4.6608" />
      <inertia ixx="0.02869" ixy="1.4201E-10" ixz="-5.016E-09" iyy="0.02869" iyz="5.2923E-09" izz="0.039839" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/wheel2_link.STL" />
      </geometry>
      <material name="wheel2_link_material">
        <color rgba="0.098039 0.098039 0.098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel2_joint" type="continuous">
    <origin xyz="-0.08 0 -0.185" rpy="1.5708 0 -1.5708" />
    <parent link="steer2_link" />
    <child link="wheel2_link" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="50" />
    <dynamics friction="0.2" />
  </joint>
  <link name="steer3_link">
    <inertial>
      <origin xyz="0.00087463 -1.9027E-08 -0.185" rpy="0 0 0" />
      <mass value="4.662" />
      <inertia ixx="0.039839" ixy="-5.0099E-09" ixz="5.303E-09" iyy="0.02869" iyz="1.5972E-10" izz="0.02869" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/steer3_link.STL" />
      </geometry>
      <material name="steer3_link_material">
        <color rgba="0.96078 0.96078 0.96471 1" />
      </material>
    </visual>
  </link>
  <joint name="steer3_joint" type="fixed">
    <origin xyz="0.425 -0.425 -0.1885" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="steer3_link" />
  </joint>
  <link name="wheel3_link">
    <inertial>
      <origin xyz="1.9002E-08 -1.9979E-08 -0.079149" rpy="0 0 0" />
      <mass value="4.6608" />
      <inertia ixx="0.02869" ixy="1.5896E-10" ixz="5.0096E-09" iyy="0.02869" iyz="-5.3024E-09" izz="0.039839" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/wheel3_link.STL" />
      </geometry>
      <material name="wheel3_link_material">
        <color rgba="0.098039 0.098039 0.098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel3_joint" type="continuous">
    <origin xyz="0.08 0 -0.185" rpy="-1.5708 0 -1.5708" />
    <parent link="steer3_link" />
    <child link="wheel3_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="50" />
    <dynamics friction="0.2" />
  </joint>
  <link name="steer4_link">
    <inertial>
      <origin xyz="0.00087464 1.9832E-08 -0.185" rpy="0 0 0" />
      <mass value="4.662" />
      <inertia ixx="0.039839" ixy="5.178E-09" ixz="5.3424E-09" iyy="0.02869" iyz="-1.6409E-10" izz="0.02869" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/steer4_link.STL" />
      </geometry>
      <material name="steer4_link_material">
        <color rgba="0.96078 0.96078 0.96471 1" />
      </material>
    </visual>
  </link>
  <joint name="steer4_joint" type="fixed">
    <origin xyz="-0.42458 -0.425 -0.1885" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="steer4_link" />
  </joint>
  <link name="wheel4_link">
    <inertial>
      <origin xyz="-1.9834E-08 -2.009E-08 -0.079149" rpy="0 0 0" />
      <mass value="4.6609" />
      <inertia ixx="0.02869" ixy="-1.6283E-10" ixz="-5.178E-09" iyy="0.02869" iyz="-5.3409E-09" izz="0.039839" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_steering_v1/meshes/wheel4_link.STL" />
      </geometry>
      <material name="wheel4_link_material">
        <color rgba="0.098039 0.098039 0.098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel4_joint" type="continuous">
    <origin xyz="0.08 0 -0.185" rpy="-1.5708 0 -1.5708" />
    <parent link="steer4_link" />
    <child link="wheel4_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="50" />
    <dynamics friction="0.2" />
  </joint>
  <gazebo reference="wheel1_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel2_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel3_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel4_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel1_joint</left_joint>
      <left_joint>wheel2_joint</left_joint>
      <right_joint>wheel3_joint</right_joint>
      <right_joint>wheel4_joint</right_joint>
      <wheel_separation>0.85</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel1_joint</joint_name>
      <joint_name>wheel2_joint</joint_name>
      <joint_name>wheel3_joint</joint_name>
      <joint_name>wheel4_joint</joint_name>
    </plugin>
  </gazebo>
  <link name="lidar_link">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06" />
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.3" />
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <link name="camera_link">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry><box size="0.08 0.12 0.08" /></geometry>
      <material name="camera_black"><color rgba="0.08 0.08 0.08 1" /></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.40 0 0.30" />
  </joint>
  <!-- ROS optical convention: +Z forward, +X right, +Y down. -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796326794897 0 -1.570796326794897" />
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.396263401595464</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>50</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <link name="imu_link">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.1" />
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu />
    </sensor>
  </gazebo>
</robot>
